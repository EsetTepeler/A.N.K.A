# Bu dosyayi .env olarak kopyala ve degerleri doldur
# cp .env.example .env

# --- LLM ---
GEMINI_API_KEY=buraya-api-anahtarin
GEMINI_MODEL=gemini-2.5-flash
# Ucuz/sik isler icin (niyet siniflandirma vb.) - Faz 5'te kullanilacak
GEMINI_LITE_MODEL=gemini-2.5-flash-lite

# --- Altyapi ---
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# --- Core API ---
ANKA_HOST=0.0.0.0
ANKA_PORT=8000
ANKA_DB_PATH=/data/anka.db

# Lokalde docker olmadan calistirirken:
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=http://localhost:6333
# ANKA_DB_PATH=./data/anka.db
