# Bu dosyayi .env olarak kopyala ve degerleri doldur
# cp .env.example .env

# --- LLM ---
GEMINI_API_KEY=buraya-api-anahtarin
GEMINI_MODEL=gemini-2.5-flash
# Ucuz/sik isler icin (niyet siniflandirma vb.) - Faz 5'te kullanilacak
GEMINI_LITE_MODEL=gemini-2.5-flash-lite

# --- Altyapi ---
# Lokal (make run) degerleri. Docker'da compose bunlari kendi ici adreslerle ezer.
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# --- Core API ---
ANKA_HOST=0.0.0.0
# Host makinede acilacak port (sunucuda 8000 doluysa degistir, orn: 8080)
ANKA_PORT=8000
ANKA_DB_PATH=./data/anka.db

# --- RAG ---
# Docker: host'taki bu dizin konteynere /projects olarak baglanir
# Sunucuda orn: ANKA_PROJECTS_DIR=/home/eset/projeler
ANKA_PROJECTS_DIR=./projects
# Lokal (make run): uygulamanin dogrudan bakacagi dizin
# Orn: ANKA_PROJECTS_ROOT=C:/Projeler
ANKA_PROJECTS_ROOT=./projects

# Cakisan portlar icin (istege bagli):
# QDRANT_PORT=6333
# REDIS_PORT=6379
